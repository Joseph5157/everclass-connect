# Copy to .env for local dev (never commit .env). On Railway, set these as service variables.
DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://connect.example.com
# DATABASE_URL=postgres://user:pass@host:5432/db   (Railway sets this for you)

# Meta app (developers.facebook.com > your app > App settings > Basic)
META_APP_SECRET=
# Any long random string; paste the same value in Meta > WhatsApp > Configuration > Webhook
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a backup: if this key is lost, stored tokens cannot be decrypted.
FIELD_ENCRYPTION_KEY=

DEFAULT_COUNTRY_CODE=91
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=20
MESSAGE_MAX_ATTEMPTS=6
LOG_LEVEL=INFO
